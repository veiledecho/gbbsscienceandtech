generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

enum Role {
  STUDENT
  EXECUTIVE
  FACULTY_ADVISOR
  ADMIN
}

enum ProposalStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  ACTIVE
  COMPLETED
}

enum CheckoutStatus {
  ACTIVE
  RETURNED
  OVERDUE
}

model User {
  id              String             @id @default(cuid())
  name            String?
  email           String?            @unique
  emailVerified   DateTime?
  image           String?
  passwordHash    String?
  studentId       String?            @unique
  role            Role               @default(STUDENT)
  accounts        Account[]
  sessions        Session[]
  checkouts       CheckoutLog[]
  proposals       ProjectProposal[]  @relation("ProposalLeader")
  attendance      AttendanceSession[]
  bulletins       BulletinPost[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionToken])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model HardwareItem {
  id         String        @id @default(cuid())
  name       String
  slug       String        @unique
  category   String
  qty        Int           @default(0)
  specs      String        @db.Text
  pinout     Json
  location   String
  imageUrl   String?
  checkouts  CheckoutLog[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([category])
  @@index([name])
}

model CheckoutLog {
  id           String         @id @default(cuid())
  hardwareId   String
  userId       String
  borrowerName String
  qty          Int
  dueDate      DateTime
  returnDate   DateTime?
  projectRef   String?
  status       CheckoutStatus @default(ACTIVE)
  createdAt    DateTime       @default(now())
  hardware     HardwareItem   @relation(fields: [hardwareId], references: [id], onDelete: Restrict)
  user         User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([hardwareId, status])
  @@index([dueDate, status])
}

model ProjectProposal {
  id             String         @id @default(cuid())
  title          String
  slug           String         @unique
  leaderId       String
  teamMembers    String[]       @default([])
  abstract       String         @db.Text
  status         ProposalStatus @default(DRAFT)
  bomItems       Json           @default("[]")
  feedback       String?        @db.Text
  attachmentUrl  String?
  attachmentUrls String[]       @default([])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  leader         User           @relation("ProposalLeader", fields: [leaderId], references: [id], onDelete: Restrict)
  firmwareFiles  FirmwareFile[]

  @@index([status, createdAt])
  @@index([leaderId])
}

model AttendanceSession {
  id          String   @id @default(cuid())
  userId      String
  studentName String
  studentId   String
  station     String
  sessionType String
  objective   String   @db.Text
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([userId, createdAt])
}

model BulletinPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  category    String
  authorId    String
  content     String   @db.Text
  publishedAt DateTime @default(now())
  author      User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([publishedAt])
  @@index([category])
}

model FirmwareFile {
  id         String         @id @default(cuid())
  proposalId String
  fileName   String
  language   String
  content    String         @db.Text
  updatedAt  DateTime       @updatedAt
  proposal   ProjectProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, fileName])
  @@index([fileName])
}